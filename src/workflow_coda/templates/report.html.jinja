{# The report page skeleton — the framework-owned chrome.

   Context (supplied entirely by the renderer; this template decides
   presentation only, never data):

     document         the ReportDocument
     tabs             (tab, anchor, body) triples, one per document
                      tab: the DocumentTab, its unique anchor id, and
                      the framework-assembled body for its node tree
                      (marked safe below — the walk escaped every
                      framework text and left exactly one raw point,
                      the plugin html of rendered components)
     has_tabs         whether the report has more than one tab; a
                      single-tab report renders no tab bar
     css_tokens       generated ":root" block (theme -> properties)
     css_base         merged framework stylesheets: style.css and
                      selection.css
     css_layout       the generated split-ratio rules (may be empty)
     component_css    the component style block — banner-commented
                      plugin css after the framework's own style, or
                      empty when no component contributed
     plotly_js        the inlined Plotly.js library, or None when no
                      entry contains a figure
     report_js        merged URL codec, selection policy, selector
                      planner, and tab/state controller; None unless
                      the document has multiple tabs or states
     component_js     the component script block — banner-commented
                      plugin js after the framework's own scripts, or
                      empty when no component contributed
     provenance_lines footer lines extracted from the manifest
     attribution      the "generated by workflow-coda" line

   Escaping: everything the template prints is autoescaped except
   four raw families: the framework-owned blocks (css_tokens,
   css_base, css_layout, plotly_js, report_js), the assembled tab
   bodies — inside which the walk's single marked point carries a
   rendered component's plugin html — the component blocks
   (component_css, component_js), plugin chrome guarded at
   declaration, raw into the page like plugin html, — and an inline
   logo's svg markup, sanitized at build through the icon validator. #}
{% from "macros.jinja" import provenance_footer %}
<!doctype html>
<html lang="en">
  <head>
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; connect-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'unsafe-inline'"
    >
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.title }}</title>
    {% if document.favicon %}
    <link rel="icon" href="{{ document.favicon.data_uri }}">
    {% endif %}
    <style>
{{ css_tokens | safe }}
{{ css_base | safe }}
{{ css_layout | safe }}
    </style>
{{ component_css | safe }}
    {% if plotly_js %}
    <script>{{ plotly_js | safe }}</script>
    {% endif %}
  </head>
  <body>
    <header class="coda-headerbar">
      <div class="coda-headerbar-inner">
        <div class="coda-brand">
          {% if document.logo and document.logo.is_inline %}
          {{ document.logo.markup | safe }}
          {% elif document.logo %}
          <img class="coda-logo" src="{{ document.logo.data_uri }}" alt="">
          {% endif %}
          <div class="coda-brand-text">
            <h1>{{ document.title }}</h1>
            {% if document.version %}
            <p class="coda-version">{{ document.version }}</p>
            {% endif %}
            {% if document.subtitle %}
            <p class="coda-subtitle">{{ document.subtitle }}</p>
            {% endif %}
          </div>
        </div>
        {% if has_tabs %}
        <nav class="coda-tabs" role="tablist" aria-label="Report sections">
          {% for tab, anchor, body in tabs %}
          <button type="button" class="coda-tab" role="tab" id="tabbtn-{{ anchor }}" aria-controls="{{ anchor }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ 0 if loop.first else -1 }}" data-target="{{ anchor }}">{{ tab.title }}</button>
          {% endfor %}
        </nav>
        {% endif %}
      </div>
    </header>
    <div class="coda-page">
      <main>
        {% for tab, anchor, body in tabs %}
        <section class="coda-tabpanel" id="{{ anchor }}"{% if has_tabs %} role="tabpanel" aria-labelledby="tabbtn-{{ anchor }}"{% endif %}>
          <h2>{{ tab.title }}</h2>
          {{ body | safe }}
        </section>
        {% endfor %}
      </main>
      {{ provenance_footer(document, provenance_lines, attribution) }}
    </div>
    {% if dropdown_icon %}
    <template id="coda-dropdown-icon">{{ dropdown_icon | safe }}</template>
    {% endif %}
    {% if report_js %}
    <script>{{ report_js | safe }}</script>
    {% endif %}
{{ component_js | safe }}
  </body>
</html>
