{# The report page skeleton — the framework-owned chrome.

   Context (supplied entirely by the renderer; this template decides
   presentation only, never data):

     document         the ReportDocument
     tabs             (tab, anchor, body) triples, one per document
                      tab: the DocumentTab, its unique anchor id, and
                      the framework-assembled body for its node tree
                      (marked safe below — the walk escaped every
                      framework text and left exactly one raw point,
                      the plugin html of rendered components)
     has_tabs         whether the report has more than one tab; a
                      single-tab report renders no bar and no script
     css_tokens       generated ":root" block (theme -> properties)
     css_base         the framework stylesheet (style.css)
     css_layout       the generated split-ratio rules (may be empty)
     plotly_js        the inlined Plotly.js library, or None when no
                      entry contains a figure
     report_js        the inlined tab-navigation script, or None when
                      there is no tab bar
     provenance_lines footer lines extracted from the manifest
     attribution      the "generated by workflow-coda" line

   Escaping: everything the template prints is autoescaped except the
   framework-owned blocks (css_tokens, css_base, css_layout, plotly_js,
   report_js) and the assembled tab bodies — inside which the walk's
   single marked point carries a rendered component's plugin html. #}
{% from "macros.jinja" import provenance_footer %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.title }}</title>
    {% if document.favicon %}
    <link rel="icon" href="{{ document.favicon.data_uri }}">
    {% endif %}
    <style>
{{ css_tokens | safe }}
{{ css_base | safe }}
{{ css_layout | safe }}
    </style>
    {% if plotly_js %}
    <script>{{ plotly_js | safe }}</script>
    {% endif %}
  </head>
  <body>
    <header class="coda-headerbar">
      <div class="coda-headerbar-inner">
        <div class="coda-brand">
          {% if document.logo %}
          <img class="coda-logo" src="{{ document.logo.data_uri }}" alt="">
          {% endif %}
          <div class="coda-brand-text">
            <h1>{{ document.title }}</h1>
            {% if document.version %}
            <p class="coda-version">{{ document.version }}</p>
            {% endif %}
            {% if document.subtitle %}
            <p class="coda-subtitle">{{ document.subtitle }}</p>
            {% endif %}
          </div>
        </div>
        {% if has_tabs %}
        <nav class="coda-tabs" role="tablist" aria-label="Report sections">
          {% for tab, anchor, body in tabs %}
          <button type="button" class="coda-tab" role="tab" id="tabbtn-{{ anchor }}" aria-controls="{{ anchor }}" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ 0 if loop.first else -1 }}" data-target="{{ anchor }}">{{ tab.title }}</button>
          {% endfor %}
        </nav>
        {% endif %}
      </div>
    </header>
    <div class="coda-page">
      <main>
        {% for tab, anchor, body in tabs %}
        <section class="coda-tabpanel" id="{{ anchor }}"{% if has_tabs %} role="tabpanel" aria-labelledby="tabbtn-{{ anchor }}"{% endif %}>
          <h2>{{ tab.title }}</h2>
          {{ body | safe }}
        </section>
        {% endfor %}
      </main>
      {{ provenance_footer(document, provenance_lines, attribution) }}
    </div>
    {% if report_js %}
    <script>{{ report_js | safe }}</script>
    {% endif %}
  </body>
</html>
