{# The report page skeleton — the framework-owned chrome.

   Context (supplied entirely by the renderer; this template decides
   presentation only, never data):

     document                  the ReportDocument
     css_tokens                generated ":root" block (theme -> custom properties)
     css_base                  the framework stylesheet (style.css)
     plotly_js                 the inlined Plotly.js library, or None
                               when no entry contains a figure
     provenance_lines          lines extracted from the manifest for
                               the footer
     attribution               the "generated by workflow-coda" line
     problem_diagnostics       diagnostics that name problems
     informational_diagnostics purely informational diagnostics

   Escaping: everything is autoescaped except three framework-owned
   points (css_tokens, css_base, plotly_js) and one plugin-owned point — a
   rendered entry's html, marked safe inside the card macro. #}
{% from "macros.jinja" import card, diagnostics_block, provenance_footer %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ document.title }}</title>
    {% if document.favicon %}
    <link rel="icon" href="{{ document.favicon.data_uri }}">
    {% endif %}
    <style>
{{ css_tokens | safe }}
{{ css_base | safe }}
    </style>
    {% if plotly_js %}
    <script>{{ plotly_js | safe }}</script>
    {% endif %}
  </head>
  <body>
    <header class="coda-headerbar">
      <div class="coda-headerbar-inner">
        <div class="coda-brand">
          {% if document.logo %}
          <img class="coda-logo" src="{{ document.logo.data_uri }}" alt="">
          {% endif %}
          <div class="coda-brand-text">
            <h1>{{ document.title }}</h1>
            {% if document.version %}
            <p class="coda-version">{{ document.version }}</p>
            {% endif %}
            {% if document.subtitle %}
            <p class="coda-subtitle">{{ document.subtitle }}</p>
            {% endif %}
          </div>
        </div>
        {% if document.toc and document.sections %}
        <nav class="coda-tabs" aria-label="Table of contents">
          {% for section in document.sections %}
          {% set anchor = loop.index ~ "-" ~ (section.title | slugify) %}
          <a href="#{{ anchor }}">{{ section.title }}</a>
          {% endfor %}
          {% if document.diagnostics %}
          <a href="#diagnostics">Diagnostics</a>
          {% endif %}
        </nav>
        {% endif %}
      </div>
    </header>
    <div class="coda-page">
      <main>
        {% for section in document.sections %}
        {% set anchor = loop.index ~ "-" ~ (section.title | slugify) %}
        <section class="coda-section" id="{{ anchor }}">
          <h2>{{ section.title }}</h2>
          {% for entry in section.entries %}
          {{ card(entry) }}
          {% endfor %}
        </section>
        {% endfor %}
      </main>
      {% if document.diagnostics %}
      {{ diagnostics_block(problem_diagnostics, informational_diagnostics) }}
      {% endif %}
      {{ provenance_footer(document, provenance_lines, attribution) }}
    </div>
  </body>
</html>
