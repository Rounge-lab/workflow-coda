{# Chrome macros: presentation only, no data decisions.

   The card and diagnostics macros moved into the renderer's tree
   walk in layout schema 0.3.0 — the node tree dispatches on
   dataclass shape, which belongs in Python.  The footer stayed a
   macro because it is flat and framework-owned. #}


{# The report footer: author, the manifest's provenance, and the
   framework attribution.  Deliberately link-free — the report is
   self-contained, and that promise binds our own footer too. #}
{% macro provenance_footer(document, provenance_lines, attribution) %}
<footer class="coda-footer">
  {% if document.author %}
  <p class="coda-author">{{ document.author }}</p>
  {% endif %}
  {% if provenance_lines %}
  <ul class="coda-provenance">
    {% for line in provenance_lines %}
    <li>{{ line }}</li>
    {% endfor %}
  </ul>
  {% endif %}
  <p class="coda-attribution">{{ attribution }}</p>
</footer>
{% endmacro %}
